{
  "name": "diff-notes",
  "displayName": "Diff Notes",
  "description": "PR-style notes on local, unpushed commits and uncommitted changes.",
  "version": "0.1.0",
  "publisher": "bero-labs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.145.0"
  },
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/Solus/diff-notes.git" },
  "bugs": { "url": "https://github.com/Solus/diff-notes/issues" },
  "homepage": "https://github.com/Solus/diff-notes#readme",
  "keywords": ["git", "code review", "comments", "notes", "diff", "unpushed"],
  "categories": ["SCM Providers", "Other"],
  "main": "./out/src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["vscode.git"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "diffNotes", "title": "Diff Notes", "icon": "media/diff-notes.svg" }
      ]
    },
    "views": {
      "diffNotes": [
        { "id": "diffNotes.commits", "name": "Commits" },
        { "id": "diffNotes.comments", "name": "Comments" }
      ]
    },
    "viewsWelcome": [
      { "view": "diffNotes.commits", "contents": "No Git repository found in this workspace." },
      { "view": "diffNotes.comments", "contents": "No Git repository found in this workspace.", "when": "!gitOpenRepositoryCount" }
    ],
    "configuration": {
      "title": "Diff Notes",
      "properties": {
        "diffNotes.autoClearPushedDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Automatically delete notes on pushed commits this many days after the commit was first seen as pushed. `0` = off."
        }
      }
    },
    "colors": [
      {
        "id": "diffNotes.fileNoteForeground",
        "description": "Colour of file names in the Commits view that have open Diff Notes notes (overrides the git status colour).",
        "defaults": { "dark": "#d9a843", "light": "#b8860b", "highContrast": "#ffd866", "highContrastLight": "#8a6500" }
      },
      {
        "id": "diffNotes.overviewRulerMarker",
        "description": "Scrollbar (overview ruler) mark for lines that have an open Diff Notes note.",
        "defaults": { "dark": "#d9a843cc", "light": "#b8860bcc", "highContrast": "#ffd866", "highContrastLight": "#8a6500" }
      }
    ],
    "commands": [
      { "command": "diffNotes.groupByCommit", "title": "Group by Commit", "shortTitle": "Commit", "category": "Diff Notes", "toggled": "diffNotes.groupMode == commit" },
      { "command": "diffNotes.groupByFile", "title": "Group by File", "shortTitle": "File", "category": "Diff Notes", "toggled": "diffNotes.groupMode == file" },
      { "command": "diffNotes.groupByNone", "title": "Group by None", "shortTitle": "None", "category": "Diff Notes", "toggled": "diffNotes.groupMode == none" },
      { "command": "diffNotes.openOnly", "title": "Show Open Only", "category": "Diff Notes", "icon": "$(filter)" },
      { "command": "diffNotes.showAll", "title": "Show Resolved Too", "category": "Diff Notes", "icon": "$(filter-filled)" },
      { "command": "diffNotes.openComment", "title": "Open Comment", "category": "Diff Notes" },
      { "command": "diffNotes.openFile", "title": "Open File", "category": "Diff Notes", "icon": "$(go-to-file)" },
      { "command": "diffNotes.openDiffFile", "title": "Open File", "category": "Diff Notes", "icon": "$(go-to-file)" },
      { "command": "diffNotes.openCommitFile", "title": "Open File", "category": "Diff Notes", "icon": "$(go-to-file)" },
      { "command": "diffNotes.openCurrentDiff", "title": "Open Current Diff", "category": "Diff Notes", "icon": "$(diff)" },
      { "command": "diffNotes.previousNote", "title": "Previous Note", "category": "Diff Notes", "icon": "$(arrow-circle-up)" },
      { "command": "diffNotes.nextNote", "title": "Next Note", "category": "Diff Notes", "icon": "$(arrow-circle-down)" },
      { "command": "diffNotes.refresh", "title": "Refresh", "category": "Diff Notes", "icon": "$(refresh)" },
      { "command": "diffNotes.openDiff", "title": "Open Diff", "category": "Diff Notes" },
      { "command": "diffNotes.createComment", "title": "Add Note", "category": "Diff Notes" },
      { "command": "diffNotes.cancelDraft", "title": "Cancel", "category": "Diff Notes" },
      { "command": "diffNotes.reply", "title": "Reply", "category": "Diff Notes" },
      { "command": "diffNotes.editComment", "title": "Edit", "category": "Diff Notes", "icon": "$(edit)" },
      { "command": "diffNotes.saveComment", "title": "Save", "category": "Diff Notes" },
      { "command": "diffNotes.cancelEdit", "title": "Cancel", "category": "Diff Notes" },
      { "command": "diffNotes.resolve", "title": "Resolve", "category": "Diff Notes", "icon": "$(check)" },
      { "command": "diffNotes.reopen", "title": "Reopen", "category": "Diff Notes", "icon": "$(issue-reopened)" },
      { "command": "diffNotes.deleteComment", "title": "Delete", "category": "Diff Notes", "icon": "$(trash)" },
      { "command": "diffNotes.deleteNote", "title": "Delete Note", "category": "Diff Notes" },
      { "command": "diffNotes.copyNotes", "title": "Copy Notes", "category": "Diff Notes", "icon": "$(copy)" },
      { "command": "diffNotes.copyNode", "title": "Copy", "category": "Diff Notes" },
      { "command": "diffNotes.deleteResolved", "title": "Delete All Resolved", "category": "Diff Notes" },
      { "command": "diffNotes.deletePushed", "title": "Delete All Pushed", "category": "Diff Notes" },
      { "command": "diffNotes.deleteOutdated", "title": "Delete All Outdated", "category": "Diff Notes" }
    ],
    "keybindings": [
      { "command": "diffNotes.nextNote", "key": "alt+n", "when": "isInDiffEditor && resourceScheme == diff-notes" },
      { "command": "diffNotes.previousNote", "key": "alt+p", "when": "isInDiffEditor && resourceScheme == diff-notes" }
    ],
    "submenus": [
      { "id": "diffNotes.groupBySubmenu", "label": "Group By", "icon": "$(list-tree)" }
    ],
    "menus": {
      "diffNotes.groupBySubmenu": [
        { "command": "diffNotes.groupByCommit", "group": "1_mode@1" },
        { "command": "diffNotes.groupByFile", "group": "1_mode@2" },
        { "command": "diffNotes.groupByNone", "group": "1_mode@3" }
      ],
      "view/title": [
        { "submenu": "diffNotes.groupBySubmenu", "when": "view == diffNotes.comments", "group": "navigation@1" },
        { "command": "diffNotes.showAll", "when": "view == diffNotes.comments && diffNotes.openOnly", "group": "navigation@2" },
        { "command": "diffNotes.openOnly", "when": "view == diffNotes.comments && !diffNotes.openOnly", "group": "navigation@2" },
        { "command": "diffNotes.refresh", "when": "view == diffNotes.commits", "group": "navigation" },
        { "command": "diffNotes.copyNotes", "when": "view == diffNotes.comments", "group": "navigation@3" },
        { "command": "diffNotes.deleteResolved", "when": "view == diffNotes.comments", "group": "cleanup@1" },
        { "command": "diffNotes.deletePushed", "when": "view == diffNotes.comments", "group": "cleanup@2" },
        { "command": "diffNotes.deleteOutdated", "when": "view == diffNotes.comments", "group": "cleanup@3" }
      ],
      "view/item/context": [
        { "command": "diffNotes.copyNode", "when": "view == diffNotes.comments && viewItem =~ /^(open|resolved|commentGroup)$/", "group": "1_copy" },
        { "command": "diffNotes.deleteNote", "when": "view == diffNotes.comments && viewItem =~ /^(open|resolved)$/", "group": "9_delete" },
        { "command": "diffNotes.openFile", "when": "view == diffNotes.comments && viewItem =~ /^(open|resolved)$/", "group": "inline" },
        { "command": "diffNotes.openCommitFile", "when": "view == diffNotes.commits && viewItem == file", "group": "inline" }
      ],
      "comments/commentThread/context": [
        { "command": "diffNotes.createComment", "when": "commentController == diffNotes && commentThreadIsEmpty", "group": "inline@1" },
        { "command": "diffNotes.cancelDraft", "when": "commentController == diffNotes", "group": "inline@2" },
        { "command": "diffNotes.reply", "when": "commentController == diffNotes && !commentThreadIsEmpty", "group": "inline@1" }
      ],
      "editor/title": [
        { "command": "diffNotes.previousNote", "when": "resourceScheme == diff-notes", "group": "navigation@1" },
        { "command": "diffNotes.nextNote", "when": "resourceScheme == diff-notes", "group": "navigation@2" },
        { "command": "diffNotes.openDiffFile", "when": "resourceScheme == diff-notes", "group": "navigation" }
      ],
      "comments/commentThread/title": [
        { "command": "diffNotes.openFile", "when": "commentController == diffNotes", "group": "navigation" },
        { "command": "diffNotes.resolve", "when": "commentController == diffNotes && commentThread =~ /open$/", "group": "navigation" },
        { "command": "diffNotes.openCurrentDiff", "when": "commentController == diffNotes && commentThread =~ /^outdated/", "group": "navigation" },
        { "command": "diffNotes.reopen", "when": "commentController == diffNotes && commentThread =~ /resolved$/", "group": "navigation" }
      ],
      "comments/comment/title": [
        { "command": "diffNotes.editComment", "when": "commentController == diffNotes && comment == editable", "group": "inline@1" },
        { "command": "diffNotes.deleteComment", "when": "commentController == diffNotes && comment == editable", "group": "inline@2" }
      ],
      "comments/comment/context": [
        { "command": "diffNotes.saveComment", "when": "commentController == diffNotes", "group": "inline@1" },
        { "command": "diffNotes.cancelEdit", "when": "commentController == diffNotes", "group": "inline@2" }
      ],
      "commandPalette": [
        { "command": "diffNotes.previousNote", "when": "resourceScheme == diff-notes" },
        { "command": "diffNotes.nextNote", "when": "resourceScheme == diff-notes" },
        { "command": "diffNotes.openDiff", "when": "false" },
        { "command": "diffNotes.openComment", "when": "false" },
        { "command": "diffNotes.openCurrentDiff", "when": "false" },
        { "command": "diffNotes.openFile", "when": "false" },
        { "command": "diffNotes.openDiffFile", "when": "false" },
        { "command": "diffNotes.openCommitFile", "when": "false" },
        { "command": "diffNotes.createComment", "when": "false" },
        { "command": "diffNotes.cancelDraft", "when": "false" },
        { "command": "diffNotes.reply", "when": "false" },
        { "command": "diffNotes.editComment", "when": "false" },
        { "command": "diffNotes.saveComment", "when": "false" },
        { "command": "diffNotes.cancelEdit", "when": "false" },
        { "command": "diffNotes.resolve", "when": "false" },
        { "command": "diffNotes.reopen", "when": "false" },
        { "command": "diffNotes.deleteComment", "when": "false" },
        { "command": "diffNotes.deleteNote", "when": "false" },
        { "command": "diffNotes.copyNode", "when": "false" }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "package": "vsce package",
    "sandbox": "node scripts/make-sandbox.js",
    "sandbox:reset": "node scripts/make-sandbox.js --reset",
    "test": "tsc -p . && node --test --test-reporter=dot \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^4.1.0",
    "@types/vscode": "^1.145.0",
    "typescript": "^5.6.0"
  }
}
